{
  "name": "grep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Run grep and submit results, with context, as Annotations",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/grep-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "js-yaml": "^5.4.2",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@types/node": "^24.13.4",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7"
}
