{
  "name": "grep",
  "version": "0.0.0",
  "type": "module",
  "description": "Run grep and submit results, with context, as Annotations",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc && ncc build lib/main.js && sed -i 's/\\x0D$//' ./dist/index.js",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/grep-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "js-yaml": "^5.4.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@actions/glob": "^0.7.0",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@octokit/types": "^17.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
