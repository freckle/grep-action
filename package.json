{
  "name": "grep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Run grep and submit results, with context, as Annotations",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/grep-action.git"
  },
  "author": "Renaissance Learning Inc",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "js-yaml": "^5.4.2",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@types/node": "^24.13.5",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "knip": "^6.36.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
