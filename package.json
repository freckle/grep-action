{
  "name": "grep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Run grep and submit results, with context, as Annotations",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build lib/main.js --minify",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "knip": "knip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freckle/grep-action.git"
  },
  "author": "Freckle",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "js-yaml": "^5.4.1",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
